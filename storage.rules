rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // מי רשאי להעלות. רשימה אחת, מקום אחד.
    // חייב להישאר זהה ל-OWNER_EMAILS ב-config.js, ל-isOwner ב-firestore.rules
    // ול-OWNER_EMAILS ב-worker/src/index.js.
    function isOwner() {
      return request.auth != null && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in ['cortado.snir@gmail.com'];
    }
    function isImage() {
      return request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // תמונות של פוסטים: כולם יכולים לקרוא (פייסבוק ואינסטגרם צריכים גישה), רק המנהל מעלה.
    match /posts/{file} {
      allow read: if true;
      allow write: if isOwner() && isImage();
    }

    // תמונות השיחה השבועית. הקריאה פתוחה כי השרת שולח אותן ל-Gemini
    // בלי הזדהות, והכתובת עצמה מכילה טוקן אקראי שאי אפשר לנחש.
    match /brief/{week}/{file} {
      allow read: if true;
      allow write: if isOwner() && isImage();
    }
  }
}
