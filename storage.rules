rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // מי רשאי להעלות. רשימה אחת, מקום אחד.
    // חייב להישאר זהה ל-OWNER_EMAILS ב-config.js, ל-isOwner ב-firestore.rules
    // ול-OWNER_EMAILS ב-worker/src/index.js.
    function isOwner() {
      return request.auth != null && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in ['cortado.snir@gmail.com', 'limormelman@gmail.com'];
    }
    function isImage() {
      return request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    /* ⚠️ הקובץ הזה לא נפרס. הפרויקט על תוכנית Spark ו-Cloud Storage כבוי —
       ראה CLAUDE.md §2, ו-.github/workflows/deploy.yml שפורס hosting+firestore
       בלבד. הוא נשמר לתיעוד, ומהודק מראש: ביום שמישהו יעבור ל-Blaze ויפרוס
       אותו, "allow read: if true" היה הופך תמונות של צוות ולקוחות לציבוריות
       על סמך זה שקשה לנחש שם קובץ. עדיף שזה יישבר ויתוקן מאשר שייפתח בשקט. */

    // תמונות של פוסטים. אם יום אחד באמת צריך קריאה ציבורית בשביל Meta,
    // פותחים במפורש כאן — בהחלטה, לא בברירת מחדל.
    match /posts/{file} {
      allow read: if isOwner();
      allow write: if isOwner() && isImage();
    }

    // תמונות השיחה השבועית. היום הן ממילא נשלחות כ-data URL ישירות
    // מהדפדפן ולא עוברות דרך אחסון בכלל.
    match /brief/{week}/{file} {
      allow read: if isOwner();
      allow write: if isOwner() && isImage();
    }
  }
}
