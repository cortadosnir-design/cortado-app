rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // תמונות של פוסטים: כולם יכולים לקרוא (פייסבוק ואינסטגרם צריכים גישה), רק המנהל מעלה.
    match /posts/{file} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.token.email.lower() == 'cortado.snir@gmail.com'
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
