rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    function isOwner() {
      return signedIn() && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in ['cortado.snir@gmail.com'];
    }

    // חבר צוות מאושר: המנהל הוסיף אותו לרשימה. בלי זה — אין גישה לשום דבר.
    function member() {
      return signedIn() && exists(/databases/$(database)/documents/members/$(request.auth.uid));
    }
    function allowed() { return isOwner() || member(); }

    function weekPhase(wid) {
      return exists(/databases/$(database)/documents/weeks/$(wid))
        ? get(/databases/$(database)/documents/weeks/$(wid)).data.phase : 'availability';
    }

    // רשימת המאושרים. המנהל מנהל אותה; כל אחד בודק רק את עצמו.
    match /members/{uid} {
      allow read: if isOwner() || (signedIn() && request.auth.uid == uid);
      allow write: if isOwner();
    }

    // בקשות הצטרפות.
    match /joinRequests/{uid} {
      allow read: if isOwner() || (signedIn() && request.auth.uid == uid);
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name','email','photo','at'])
        && request.resource.data.name is string && request.resource.data.name.size() < 80;
      allow delete: if isOwner();
    }

    // השבוע: הצוות רואה, רק המנהל בונה.
    match /weeks/{wid} {
      allow read: if allowed();
      allow write: if isOwner();
    }

    // זמינות: כל עובד כותב רק את עצמו, ורק כל עוד השבוע לא ננעל.
    match /availability/{id} {
      allow read: if allowed();
      allow create, update: if allowed()
        && request.resource.data.uid == request.auth.uid
        && id == request.resource.data.week + '_' + request.auth.uid
        && request.resource.data.keys().hasOnly(['week','uid','days','note','at'])
        && request.resource.data.days is map
        && request.resource.data.days.size() <= 7
        && (!('note' in request.resource.data) || request.resource.data.note.size() < 300)
        && weekPhase(request.resource.data.week) != 'locked';
      allow delete: if isOwner() || (allowed() && resource.data.uid == request.auth.uid);
    }

    // שיבוץ: רק בשבוע שהמנהל אישר ופתח. כל אחד רושם ומוחק את עצמו.
    match /signups/{id} {
      allow read: if allowed();
      allow create: if allowed()
        && request.resource.data.uid == request.auth.uid
        && id == request.resource.data.week + '_' + request.resource.data.shift + '_' + request.auth.uid
        && request.resource.data.keys().hasOnly(['week','shift','uid','at'])
        && weekPhase(request.resource.data.week) == 'open';
      allow delete: if allowed() && (resource.data.uid == request.auth.uid || isOwner());
      allow update: if false;
    }

    // קריאייטיב, לוח התוכן, זיכרון המותג ורשימת הצוות: המנהל בלבד.
    match /creative/{wid} { allow read, write: if isOwner(); }
    match /posts/{id}    { allow read, write: if isOwner(); }
    match /brand/{doc}   { allow read, write: if isOwner(); }
    match /team/{id}     { allow read, write: if isOwner(); }

    // יומן משמרת: כל עובד מדווח על עצמו, וכולם רואים את הסיכום.
    match /log/{id} {
      allow read: if allowed();
      allow create, update: if allowed()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && (request.resource.data.customers == null || request.resource.data.customers is int)
        && request.resource.data.keys().hasOnly(['date','customers','peak','weather','promo','notes','uid','by','at']);
      allow delete: if isOwner();
    }

    // שעות פתיחה לדף הציבורי: כולם קוראים, רק המנהל כותב.
    match /public/hours {
      allow read: if true;
      allow write: if isOwner();
    }

    // כרטיס משתמש.
    match /users/{uid} {
      allow read: if isOwner() || (signedIn() && request.auth.uid == uid);
      allow write: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name','email','photo','lastSeen']);
    }
  }
}
