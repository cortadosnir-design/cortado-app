rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    // רשימת המנהלים. חייבת להיות זהה ל-OWNER_EMAILS ב-config.js,
    // ל-isOwner ב-storage.rules ול-OWNER_EMAILS ב-worker/src/index.js.
    // להוספת מנהלת: עוד מחרוזת ברשימה, בכל ארבעת המקומות.
    function isOwner() {
      return signedIn() && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in ['cortado.snir@gmail.com', 'limormelman@gmail.com'];
    }

    // חבר צוות שנכנס עם גוגל (מסלול המנהלים). העובדים הרגילים לא צריכים את זה.
    function member() {
      return signedIn() && exists(/databases/$(database)/documents/members/$(request.auth.uid));
    }
    function allowed() { return isOwner() || member(); }

    // קוד אישי תקף = מישהו שהמנהל הנפיק לו קישור. הקוד באורך 20 תווים אקראיים,
    // ואי אפשר לגלות אותו בלי לקבל אותו. זה מה שמחליף סיסמה.
    // קוד תקף = קיים ברשימה *וגם* לא הושבת. השבתה חייבת להיאכף כאן,
    // לא רק בקוד הדפדפן, אחרת עובד שעזב ממשיך לכתוב.
    function validToken(t) {
      return t is string && t.size() >= 20 && t.size() <= 64
        && exists(/databases/$(database)/documents/roster/$(t))
        && get(/databases/$(database)/documents/roster/$(t)).data.get('active', true) == true;
    }
    function weekOk(w) {
      return w is string && w.matches('^w[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && exists(/databases/$(database)/documents/weeks/$(w));
    }
    function daysOk(d) {
      return d is map && d.size() <= 7 && d.values().hasOnly(['yes','maybe','no']);
    }

    // שים לב: מסמך שבוע שנוצר לפני שהוגדר שלב לא מכיל את השדה phase.
    // גישה לשדה חסר מפילה את כל הערכת החוק, ולכן בודקים קיום לפני קריאה.
    function weekPhase(wid) {
      return exists(/databases/$(database)/documents/weeks/$(wid))
        ? ('phase' in get(/databases/$(database)/documents/weeks/$(wid)).data
            ? get(/databases/$(database)/documents/weeks/$(wid)).data.phase
            : 'availability')
        : 'availability';
    }

    // ── רשימת העובדים והקישורים האישיים ──
    // get בלבד: צריך לדעת את הקוד המדויק. אי אפשר לרשום את הקולקציה ולגלות קודים.
    match /roster/{token} {
      allow get: if true;
      allow list: if isOwner();
      allow write: if isOwner();
    }

    // ── השבוע ──
    match /weeks/{wid} {
      allow get: if true;              // דף העובד צריך לדעת אילו משמרות יש
      allow list: if allowed();
      allow write: if isOwner();
    }

    // ── זמינות ──
    match /availability/{id} {
      allow get: if true;              // צריך לדעת את הקוד המדויק
      allow list: if allowed();
      allow create, update: if
        request.resource.data.keys().hasOnly(['week','token','uid','name','days','note','at'])
        && weekOk(request.resource.data.week)
        && daysOk(request.resource.data.days)
        && (!('note' in request.resource.data) || request.resource.data.note.size() < 300)
        && (!('name' in request.resource.data) || request.resource.data.name.size() < 80)
        && weekPhase(request.resource.data.week) != 'locked'
        && (
          isOwner()
          || (validToken(request.resource.data.token)
              && id == request.resource.data.week + '_' + request.resource.data.token)
          || (allowed() && request.resource.data.uid == request.auth.uid
              && id == request.resource.data.week + '_' + request.auth.uid)
        );
      allow delete: if isOwner();
    }

    // ── שיבוץ למשמרות ──
    // נפתח רק אחרי שהמנהל אישר את השבוע (phase == 'open').
    // הקוד האישי נשמר כאן, ולכן הרשימה סגורה. עובד קורא רק את המסמך שלו,
    // לפי מזהה שהוא מרכיב מהקוד שלו — מי שאין לו את הקוד לא יכול להגיע אליו.
    match /signups/{id} {
      allow get: if true;
      allow list: if allowed();
      allow create: if
        request.resource.data.keys().hasOnly(['week','shift','token','uid','name','at'])
        && (!('name' in request.resource.data) || request.resource.data.name.size() < 80)
        && request.resource.data.shift is string && request.resource.data.shift.size() <= 40
        && weekOk(request.resource.data.week)
        && weekPhase(request.resource.data.week) == 'open'
        && (
          isOwner()
          || (validToken(request.resource.data.token)
              && id == request.resource.data.week + '_' + request.resource.data.shift + '_' + request.resource.data.token)
          || (allowed() && request.resource.data.uid == request.auth.uid
              && id == request.resource.data.week + '_' + request.resource.data.shift + '_' + request.auth.uid)
        );
      allow delete: if isOwner()
        || (validToken(resource.data.get('token', ''))
            && id == resource.data.week + '_' + resource.data.shift + '_' + resource.data.token
            && weekPhase(resource.data.week) == 'open')
        || (allowed() && resource.data.get('uid', '') == request.auth.uid);
      allow update: if false;
    }

    // ── קריאייטיב, לוח התוכן וזיכרון המותג: המנהל בלבד ──
    match /creative/{wid} { allow read, write: if isOwner(); }
    // דוחות סגירת קופה: מספרי הכנסות. רק הבעלים, קריאה וכתיבה.
    match /sales/{id}    { allow read, write: if isOwner(); }
    match /posts/{id}    { allow read, write: if isOwner(); }
    match /brand/{doc}   { allow read, write: if isOwner(); }

    // ── יומן משמרת ──
    // שני מסלולי כתיבה: מנהל/חבר צוות שנכנס עם גוגל (מזהה <date>_<uid>),
    // ועובד עם קישור אישי (מזהה <date>_<shift>_<token>). מי שעמד במשמרת הוא
    // היחיד שיודע מה קרה בה — ולכן הוא חייב להיות מי שמדווח.
    match /log/{id} {
      allow get: if true;              // המזהה מכיל uid או קוד אישי. בלעדיהם אין דרך להגיע אליו.
      allow list: if allowed();
      allow create, update: if
        request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && (!('customers' in request.resource.data) || request.resource.data.customers == null
            || request.resource.data.customers is int)
        && (!('notes' in request.resource.data) || request.resource.data.notes.size() <= 600)
        && (!('missing' in request.resource.data) || request.resource.data.missing.size() <= 200)
        && request.resource.data.keys().hasOnly(
             ['date','shift','customers','peak','weather','promo','notes','missing','uid','token','by','at'])
        && (
          // מסלול גוגל
          (allowed() && request.resource.data.get('uid', '') == request.auth.uid
           && id == request.resource.data.date + '_' + request.auth.uid)
          // מסלול קוד אישי — רק על משמרת שהעובד באמת משובץ אליה
          || (validToken(request.resource.data.get('token', ''))
              && request.resource.data.shift is string
              && request.resource.data.shift.size() <= 40
              && id == request.resource.data.date + '_' + request.resource.data.shift + '_' + request.resource.data.token)
        );
      allow delete: if isOwner();
    }

    // ── שעות פתיחה לדף הציבורי ──
    match /public/hours {
      allow read: if true;
      allow write: if isOwner();
    }

    // ── כרטיס משתמש (רק למי שנכנס עם גוגל) ──
    match /users/{uid} {
      allow read: if isOwner() || (signedIn() && request.auth.uid == uid);
      allow write: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name','email','photo','lastSeen']);
    }

    // ── בקשות הצטרפות דרך גוגל ──
    match /members/{uid} {
      allow read: if isOwner() || (signedIn() && request.auth.uid == uid);
      allow write: if isOwner();
    }
    match /joinRequests/{uid} {
      allow read: if isOwner() || (signedIn() && request.auth.uid == uid);
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name','email','photo','at'])
        && request.resource.data.name is string && request.resource.data.name.size() < 80;
      allow delete: if isOwner();
    }
  }
}
