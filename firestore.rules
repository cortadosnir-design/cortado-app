rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isOwner() {
      return signedIn() && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in ['cortado.snir@gmail.com'];
    }
    function weekOpen(wid) {
      return exists(/databases/$(database)/documents/weeks/$(wid))
        && get(/databases/$(database)/documents/weeks/$(wid)).data.open == true;
    }

    // משמרות: כולם רואים, רק המנהל משנה.
    match /weeks/{wid} {
      allow read: if signedIn();
      allow write: if isOwner();
    }

    // שיבוץ: כל אחד רושם ומוחק רק את עצמו, ורק בשבוע פתוח. המנהל יכול להסיר כל אחד.
    match /signups/{id} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && id == request.resource.data.week + '_' + request.resource.data.shift + '_' + request.auth.uid
        && weekOpen(request.resource.data.week);
      allow delete: if signedIn() && (resource.data.uid == request.auth.uid || isOwner());
      allow update: if false;
    }

    // לוח התוכן ורשימת הצוות: המנהל בלבד.
    match /posts/{id} { allow read, write: if isOwner(); }
    match /team/{id}  { allow read, write: if isOwner(); }

    // יומן משמרת: כל עובד מדווח על עצמו (מסמך לכל תאריך), וכולם רואים את הסיכום.
    match /log/{id} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && id == request.resource.data.date + '_' + request.auth.uid;
      allow delete: if isOwner();
    }

    // שעות פתיחה לדף הנחיתה: כולם קוראים (גם בלי כניסה), רק המנהל כותב.
    match /public/{id} {
      allow read: if true;
      allow write: if isOwner();
    }

    // כרטיס משתמש: כל אחד כותב רק את שלו.
    match /users/{uid} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == uid;
    }
  }
}
